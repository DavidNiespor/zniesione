# Skopiuj do pliku .env (serwer) albo wpisz jako zmienne stacka (Portainer). Pliku .env nie dodawaj do repozytorium.

# ---- wymagane ----
# Klucz sesji portalu, wygeneruj:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Token tunelu: Cloudflare Zero Trust -> Networks -> Tunnels -> (tunel) -> Install connector (ciąg po --token)
TUNNEL_TOKEN=
# Token API Cloudflare do rekordów DNS (WireGuard, poczta) i certyfikatu poczty: My Profile -> API Tokens ->
# Create Token -> szablon "Edit zone DNS" -> Zone Resources: Include, Specific zone, zniesione.pl
CF_API_TOKEN=
# Hasło skrzynki administratora poczty admin@zniesione.pl (min. 10 znaków, najlepiej losowe)
MAIL_ADMIN_PASSWORD=

# ---- konto administratora portalu (tworzone raz, przy pierwszym starcie) ----
ADMIN_EMAIL=admin@zniesione.pl
# min. 8 znaków; po utworzeniu konta zmiana tej zmiennej nie zmienia hasła
ADMIN_PASSWORD=

# ---- opcjonalne ----
MAIL_DOMAIN=zniesione.pl
# nazwa skrzynki administratora poczty (przed @)
MAIL_ADMIN=admin
WG_HOST=wg.zniesione.pl
# Port UDP WireGuard na serwerze (trafia też do konfiguracji sterowników)
WG_PORT=51820
TZ=Europe/Warsaw
# Ile dni trzymać codzienne kopie bazy portalu
KEEP_DAYS=14
