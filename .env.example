# Skopiuj do pliku .env (serwer) albo wpisz jako zmienne stacka (Portainer). Pliku .env nie dodawaj do repozytorium.

# Klucz sesji, wygeneruj:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Token tunelu: Cloudflare Zero Trust -> Networks -> Tunnels -> (tunel) -> Install connector (ciąg po --token)
TUNNEL_TOKEN=

# Rekord DNS dla sterowników (WireGuard) ustawiany automatycznie w Cloudflare. Token: My Profile -> API Tokens ->
# Create Token -> szablon "Edit zone DNS" -> Zone Resources: Include, Specific zone, zniesione.pl.
# Bez tokenu dodaj rekord ręcznie (docs/WDROZENIE.md).
CF_API_TOKEN=
WG_HOST=wg.zniesione.pl

# Opcjonalne
TZ=Europe/Warsaw
# Port UDP WireGuard na serwerze (trafia też do konfiguracji sterowników)
WG_PORT=51820
# Ile dni trzymać codzienne kopie bazy
KEEP_DAYS=14
